generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  accounts  Account[]
  createdAt DateTime @default(now())
}

model Account {
  id        String   @id @default(cuid())
  balance   Float    @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fromTx    Transaction[] @relation("from")
  toTx      Transaction[] @relation("to")
  createdAt DateTime @default(now())
}

model Transaction {
  id            String   @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amount        Float
  status        String
  from          Account  @relation("from", fields: [fromAccountId], references: [id])
  to            Account  @relation("to", fields: [toAccountId], references: [id])
  createdAt     DateTime @default(now())
}